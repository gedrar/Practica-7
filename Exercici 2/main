#include <Arduino.h>
#include "Audio.h"
#include "SD.h"
#include "FS.h"

// Pins digitals utilitzats (Segons enunciat )
#define SD_CS          5
#define SPI_MOSI      23
#define SPI_MISO      19
#define SPI_SCK       18
#define I2S_DOUT      25
#define I2S_BCLK      27
#define I2S_LRC       26

Audio audio;

void setup() {
    pinMode(SD_CS, OUTPUT);
    digitalWrite(SD_CS, HIGH);
    
    // Inicialització SPI per a la targeta SD
    SPI.begin(SPI_SCK, SPI_MISO, SPI_MOSI);
    Serial.begin(115200);
    
    if(!SD.begin(SD_CS)){
        Serial.println("Error: No s'ha pogut muntar la targeta SD");
        return;
    }

    // Configuració pins I2S 
    audio.setPinout(I2S_BCLK, I2S_LRC, I2S_DOUT);
    audio.setVolume(12); // Nivell de volum (0-21)

    // IMPORTANT: El fitxer ha d'estar a l'arrel de la SD amb aquest nom exacte
    audio.connecttoFS(SD, "/audio.wav"); 
}

void loop() {
    audio.loop(); // Gestiona la reproducció i els callbacks 
}

// Callbacks opcionals per veure info al monitor sèrie
void audio_info(const char *info) {
    Serial.print("info: "); Serial.println(info);
}

void audio_eof_mp3(const char *info) {
    Serial.println("Final de l'arxiu.");
}
