#include <Arduino.h>
#include "AudioGeneratorAAC.h"
#include "AudioOutputI2S.h"
#include "AudioFileSourcePROGMEM.h"
#include "sampleaac.h"

AudioFileSourcePROGMEM *in;
AudioGeneratorAAC *aac;
AudioOutputI2S *out;

void setup() {
  Serial.begin(115200);
  
  // Inicialització de l'àudio des de memòria interna (PROGMEM)
  in = new AudioFileSourcePROGMEM(sampleaac, sizeof(sampleaac));
  aac = new AudioGeneratorAAC();
  out = new AudioOutputI2S();
  
  out->SetGain(0.125); // Volum
  
  // PINS CORRETS PER A ESP32-S3 (BCLK, LRC, DIN)
  // El PDF deia (26, 25, 22), però tu has de fer servir:
  out->SetPinout(17, 16, 15); 
  
  aac->begin(in, out);
}

void loop() {
  if (aac->isRunning()) {
    aac->loop();
  } else {
    aac->stop();
    Serial.printf("Sound Generator\n");
    delay(1000);
  }
}
